# ==============================================================================
# .agentignore - Token Optimization & Privacy for AI Agents
# Prevents LLM context bloat by excluding build artifacts, dependencies, and caches
# ==============================================================================

# Version Control & OS
.git/
.svn/
.hg/
.DS_Store
Thumbs.db

# Dependencies & Package Managers
node_modules/
vendor/
.venv/
venv/
env/
__pypackages__/

# Lock Files (Massive token waste if read in full context)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
composer.lock
Cargo.lock
Gemfile.lock
Podfile.lock

# Build Outputs & Generated Code
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/
target/
bin/
obj/

# Mobile (Flutter, Android, iOS)
.dart_tool/
.fvm/
.flutter-plugins
.flutter-plugins-dependencies
.packages
ios/Pods/
ios/.symlinks/
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
*.apk
*.aab
*.ipa
*.app

# Python Caches & Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Logs, Dumps & Temp Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
tmp/
temp/
*.swp
*.swo

# Databases & Large Media
*.sqlite
*.sqlite3
*.db
*.bin
*.tar
*.tar.gz
*.zip
*.7z
*.mp4
*.mp3
*.wav
